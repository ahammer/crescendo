  "Turn": {
    "properties": {
      "completedAt": {
        "description": "Unix timestamp (in seconds) when the turn completed.",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "durationMs": {
        "description": "Duration between turn start and completion in milliseconds, if known.",
